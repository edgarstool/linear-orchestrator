# Copied / overlaid with ~/.hermes/.env at runtime; this file is documentation only.
LINEAR_API_KEY=lin_api_xxxx
LINEAR_OAUTH_WEBHOOK_SECRET=lin_wh_oauth_app_xxxx   # Hermes Agent App 頁的 Signing secret（委派必備）
HERMES_PATH=/home/edgar/.local/bin/hermes
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8645
HERMES_TIMEOUT_SEC=180
DEFAULT_MODEL=
# optional: comma-separated Linear identifiers that this agent watches
AGENT_LINEAR_USER_ID=

# --- durable runtime state (see docs/STATE-PERSISTENCE.zh-TW.md) ---
# Where sessions / deliveries / webhook payloads are persisted. Point this at
# storage that survives redeploys. Defaults to ~/.local/share/linear-orchestrator.
LINEAR_ORCHESTRATOR_STATE_DIR=
# Snapshot destination; defaults to <state dir>/backups.
LINEAR_ORCHESTRATOR_BACKUP_DIR=
STATE_BACKUP_INTERVAL_SEC=86400
STATE_BACKUP_KEEP=7
# Replay deliveries interrupted by a crash / failed deploy on next start.
STATE_AUTO_RESUME=1
STATE_RESUME_MAX_AGE_SEC=3600
STATE_RESUME_LIMIT=20
PAYLOAD_RETENTION_DAYS=7
